  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Hauptaktion; ein tieferes Rot schließt beim Hover wie ein Verschluss.",
      "html": "<a class=\"ds-btn-primary\" href=\"#\">Probetraining anfragen <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 12h15M13 5l7 7-7 7\"/></svg></a>",
      "css": ".ds-btn-primary{position:relative;isolation:isolate;overflow:hidden;display:inline-flex;align-items:center;gap:.65rem;min-height:48px;padding:.75rem 1.25rem;border-radius:2px;background:var(--red-action, #d32f3a);color:#fff;font:600 1rem/1.15 Archivo,system-ui,sans-serif;text-decoration:none}.ds-btn-primary::before{content:\"\";position:absolute;inset:0;z-index:-1;background:var(--red-deep, #a91f2a);clip-path:inset(0 100% 0 0);transition:clip-path .5s cubic-bezier(.16,1,.3,1)}.ds-btn-primary:hover::before{clip-path:inset(0 0 0 0)}.ds-btn-primary svg{transition:transform .45s cubic-bezier(.16,1,.3,1)}.ds-btn-primary:hover svg{transform:translateX(4px)}.ds-btn-primary:focus-visible{outline:2px solid var(--chalk, #eeebe4);outline-offset:3px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Sekundäre Wege nach außen, z. B. „Das Programm entdecken“.",
      "html": "<a class=\"ds-btn-ghost\" href=\"#\">Das Programm entdecken</a>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;min-height:48px;padding:.75rem 1.25rem;border:1px solid rgb(238 235 228/.34);border-radius:2px;color:var(--chalk, #eeebe4);background:transparent;font:600 1rem/1.15 Archivo,system-ui,sans-serif;text-decoration:none;transition:border-color .25s}.ds-btn-ghost:hover{border-color:var(--chalk, #eeebe4)}.ds-btn-ghost:focus-visible{outline:2px solid var(--chalk, #eeebe4);outline-offset:3px}"
    },
    {
      "name": "Wahlschalter",
      "kind": "chip",
      "refersTo": "pick-chip",
      "description": "Hero-Auswahl einer Welt; gedrückt in der Weltfarbe, isoliert deren Frames.",
      "html": "<button class=\"ds-pick\" aria-pressed=\"true\" style=\"--world:#b7a1ef\"><span></span>Reformer Pilates</button>",
      "css": ".ds-pick{display:inline-flex;align-items:center;gap:10px;min-height:44px;padding:0 16px;border:1px solid rgb(238 235 228/.34);border-radius:2px;background:transparent;color:var(--chalk, #eeebe4);font:600 .97rem Archivo,system-ui,sans-serif;cursor:pointer}.ds-pick span{width:10px;height:10px;background:var(--world)}.ds-pick:hover{border-color:var(--chalk, #eeebe4)}.ds-pick[aria-pressed=true]{border-color:var(--world);background:color-mix(in srgb,var(--world) 16%,transparent)}.ds-pick:focus-visible{outline:2px solid var(--chalk, #eeebe4);outline-offset:3px}"
    },
    {
      "name": "Frame",
      "kind": "custom",
      "description": "Echtes Foto als nummerierter Frame; entwickelt sich von Graustufen in Farbe.",
      "html": "<figure class=\"ds-frame\"><div class=\"ds-frame-img\"></div><span class=\"ds-no\">01</span><span class=\"ds-cap\">Reformer-Raum</span></figure>",
      "css": ".ds-frame{position:relative;margin:0;width:180px;aspect-ratio:3/4;overflow:hidden;background:var(--ground-3, #2e2d32)}.ds-frame-img{position:absolute;inset:0;background:linear-gradient(160deg,#6c5a8f,#2a2433);filter:grayscale(1) brightness(.62);transition:filter .9s cubic-bezier(.16,1,.3,1)}.ds-frame:hover .ds-frame-img{filter:none}.ds-no,.ds-cap{position:absolute;left:0;padding:3px 6px;background:var(--ground, #1a191c);color:var(--chalk, #eeebe4);font:600 .72rem/1.3 Anybody,sans-serif;font-stretch:120%;letter-spacing:.08em;text-transform:uppercase}.ds-no{top:0}.ds-cap{bottom:0}"
    },
    {
      "name": "Tafel-Reiter",
      "kind": "card",
      "refersTo": "plate",
      "description": "Kopf einer gestapelten Tafel; bleibt beim Überdecken als Reiter sichtbar.",
      "html": "<header class=\"ds-bar\" style=\"--world:#efb049\"><h3>Boutique Gym</h3><span><i></i>fokussiert</span></header>",
      "css": ".ds-bar{display:flex;align-items:center;justify-content:space-between;gap:18px;height:52px;padding:0 24px;background:var(--ground-2, #232226);border:1px solid rgb(238 235 228/.16);color:var(--chalk, #eeebe4)}.ds-bar h3{margin:0;font:800 1.5rem/1 Anybody,sans-serif;font-stretch:118%}.ds-bar span{display:inline-flex;align-items:center;gap:9px;font:400 .92rem Archivo,sans-serif;color:var(--chalk-2, #bdb8ae)}.ds-bar i{width:10px;height:10px;background:var(--world)}"
    },
    {
      "name": "Protokoll-Chip",
      "kind": "chip",
      "refersTo": "record-chip-checked",
      "description": "Auswahl im Anfrage-Protokoll auf Papier; der Haken zeichnet sich.",
      "html": "<label class=\"ds-chip\"><input type=\"checkbox\" checked><span><svg viewBox=\"0 0 24 24\"><path pathLength=\"1\" d=\"m5 12.5 4.5 4.5L19 7.5\"/></svg>Kurse</span></label>",
      "css": ".ds-chip{position:relative;display:inline-flex}.ds-chip input{position:absolute;inset:0;opacity:0;margin:0;cursor:pointer}.ds-chip span{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 14px;border:1px solid rgb(20 19 23/.3);border-radius:2px;background:var(--paper, #f1f0eb);color:var(--ink, #141317);font:600 .95rem Archivo,sans-serif}.ds-chip svg{width:18px;height:18px;padding:1px;border:1.5px solid currentColor;fill:none;stroke:currentColor;stroke-width:2.6;stroke-dasharray:1;stroke-dashoffset:1;transition:stroke-dashoffset .3s}.ds-chip input:checked+span{background:var(--ink, #141317);color:var(--paper, #f1f0eb)}.ds-chip input:checked+span svg{stroke-dashoffset:0}.ds-chip input:focus-visible+span{outline:2px solid var(--ink, #141317);outline-offset:3px}"
    },
    {
      "name": "Protokoll-Feld",
