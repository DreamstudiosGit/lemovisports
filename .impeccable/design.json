      "css": ".ds-field{display:grid;gap:6px;padding:16px;background:var(--paper, #f1f0eb);color:var(--ink, #141317);font:700 1rem Archivo,sans-serif}.ds-field input{min-height:48px;border:0;border-bottom:1.5px solid var(--ink, #141317);background:transparent;font:500 1.1rem Archivo,sans-serif}.ds-field input:focus-visible{outline:none;border-bottom-color:var(--red-action, #d32f3a);box-shadow:0 1.5px 0 var(--red-action, #d32f3a)}"
