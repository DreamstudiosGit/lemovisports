      "css": ".ds-nav{display:flex;gap:28px;padding:16px 24px;background:var(--ground, #1a191c)}.ds-nav a{position:relative;display:inline-flex;align-items:center;min-height:44px;padding:0 4px;color:var(--chalk-2, #bdb8ae);font:500 .95rem Archivo,sans-serif;text-decoration:none}.ds-nav a:hover,.ds-nav a[aria-current=true]{color:var(--chalk, #eeebe4)}.ds-nav a[aria-current=true]::before,.ds-nav a[aria-current=true]::after{content:\"\";position:absolute;top:9px;width:6px;height:6px;border:0 solid var(--chalk, #eeebe4)}.ds-nav a[aria-current=true]::before{left:-6px;border-width:1.5px 0 0 1.5px}.ds-nav a[aria-current=true]::after{right:-6px;border-width:1.5px 1.5px 0 0}.ds-nav a:focus-visible{outline:2px solid var(--chalk, #eeebe4);outline-offset:3px}"
    }
